<Window x:Class="BimBam.App.Views.JoinSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prisijungti prie bendrinamos sesijos" Height="460" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Ieškoti dar kartą" Padding="10,3"
                    Command="{Binding SearchCommand}"/>
            <TextBlock Text="Sesiją bendrinantys kompiuteriai šiame tinkle:" FontSize="14" VerticalAlignment="Center"/>
        </DockPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding SessionName}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Foreground="Gray">
                            <Run Text="{Binding HostName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Address, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Arba įveskite kompiuterio adresą (pvz., 192.168.43.12):" Foreground="Gray"/>
            <TextBox Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="PIN kodas:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
            <TextBox x:Name="PinBox" Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" Width="100" FontSize="16" Padding="4"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Atšaukti" Width="100" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Prisijungti" Width="120" IsDefault="True"
                    Command="{Binding JoinCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
