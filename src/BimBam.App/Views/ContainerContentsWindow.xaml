<Window x:Class="BimBam.App.Views.ContainerContentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konteinerio turinys" Height="480" Width="860"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="ContentsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Detalė" Binding="{Binding PartNumber}" Width="160"/>
                <DataGridTextColumn Header="Geevers nr." Binding="{Binding GeeversNumber}" Width="120"/>
                <DataGridTextColumn Header="Šiame konteineryje" Binding="{Binding QuantityInContainer}" Width="120"/>
                <DataGridTextColumn Header="Faktiškai iš viso" Binding="{Binding ActualQuantity}" Width="110"/>
                <DataGridTextColumn Header="Tikėtasi" Binding="{Binding ExpectedQuantity}" Width="70"/>
                <DataGridTextColumn Header="Kituose konteineriuose" Binding="{Binding OtherContainers}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
