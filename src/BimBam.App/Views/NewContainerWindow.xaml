<Window x:Class="BimBam.App.Views.NewContainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Naujas konteineris" Height="240" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Konteinerio kodas:" FontSize="14" Margin="0,0,0,4"/>
        <TextBox x:Name="CodeBox" Grid.Row="1" FontSize="14" Padding="4" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="Pavadinimas (neprivaloma):" FontSize="14" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Grid.Row="3" FontSize="14" Padding="4" KeyDown="NameBox_KeyDown"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Atšaukti" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Gerai" Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
