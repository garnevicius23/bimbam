<Window x:Class="BimBam.App.Views.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BimBam" Height="180" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" FontSize="14" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Grid.Row="1" FontSize="14" Padding="4"
                 KeyDown="InputBox_KeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Atšaukti" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Gerai" Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
