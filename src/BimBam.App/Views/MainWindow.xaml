<Window x:Class="BimBam.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BimBam.App.ViewModels"
        xmlns:conv="clr-namespace:BimBam.App.Converters"
        Title="BimBam – Užsakymų tikrinimas" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: session list -->
        <DockPanel Grid.Column="0" Background="#F3F3F3" Margin="0">
            <TextBlock Text="Sesijos" FontSize="18" FontWeight="Bold" Margin="12" DockPanel.Dock="Top"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="12">
                <Button Content="Nauja sesija" Height="34" Margin="0,0,0,6"
                        Command="{Binding NewSessionCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="Atverti sesiją" Height="34" Margin="0,0,0,6"
                        Command="{Binding OpenSessionCommand}"/>
                <Button Content="Nustatymai" Height="34"
                        Command="{Binding OpenSettingsCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="DarkGreen"/>
            </StackPanel>

            <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Margin="6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right: workspace -->
        <Grid Grid.Column="1" Margin="12" DataContext="{Binding Workspace}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.RowSpan="2" Text="Pasirinkite arba sukurkite sesiją kairėje." FontSize="16" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Session, Converter={x:Static conv:NullToVisibilityConverter.Instance}}"/>

            <DockPanel Grid.Row="0" Margin="0,0,0,8"
                       Visibility="{Binding Session, Converter={x:Static conv:NullToInverseVisibilityConverter.Instance}}">
                <Button DockPanel.Dock="Right" Content="Pridėti daugiau failų į šią sesiją" Padding="10,4"
                        Command="{Binding AddFilesToSessionCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Text="{Binding Session.Name}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>

            <TabControl Grid.Row="1" Visibility="{Binding Session, Converter={x:Static conv:NullToInverseVisibilityConverter.Instance}}">
                <TabItem Header="Tikrinimas">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#EEF4FF" Padding="10" CornerRadius="4" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Skenuokite detalės, konteinerio arba veiksmo brūkšninį kodą:" FontSize="13"/>
                                <TextBox x:Name="ScanInput" FontSize="20" Padding="6" Margin="0,6,0,0"
                                         Text="{Binding ScanBuffer, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="ScanInput_KeyDown"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Padding="10" CornerRadius="4" Margin="0,0,0,8"
                                Background="{Binding FeedbackIsError, Converter={x:Static conv:BoolToFeedbackBrushConverter.Instance}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FeedbackMessage}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock FontSize="13">
                                        <Run Text="Aktyvi detalė: "/>
                                        <Run Text="{Binding ActiveLine.PartNumber, Mode=OneWay}"/>
                                        <Run Text="  Tikėtasi: "/>
                                        <Run Text="{Binding ActiveLine.ExpectedQuantity, Mode=OneWay}"/>
                                        <Run Text="  Faktiškai: "/>
                                        <Run Text="{Binding ActiveLine.ActualQuantity, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="22" FontWeight="Bold">
                                    <Run Text="{Binding SecondsRemaining, Mode=OneWay, StringFormat='{}{0}s'}"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Padding="10" CornerRadius="4" Margin="0,0,0,8" Background="#F7F7F7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Įvesti kiekį rankiniu būdu aktyviai detalei:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="QuantityInputBox" Width="80" Padding="4" VerticalContentAlignment="Center"
                                         Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="QuantityInputBox_KeyDown"/>
                                <Button Content="Nustatyti kiekį" Padding="10,4" Margin="10,0,0,0"
                                        Command="{Binding ApplyQuantityCommand}"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="OrderGrid" Grid.Row="3" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource LineStatusToBrushConverter}}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Detalė" Binding="{Binding PartNumber}" Width="160"/>
                                <DataGridTextColumn Header="Geevers nr." Binding="{Binding GeeversNumber}" Width="120"/>
                                <DataGridTextColumn Header="Tikėtasi" Binding="{Binding ExpectedQuantity}" Width="70"/>
                                <DataGridTextColumn Header="Faktiškai" Binding="{Binding ActualQuantity}" Width="70"/>
                                <DataGridTextColumn Header="Būsena" Binding="{Binding Status, Converter={StaticResource LineStatusToTextConverter}}" Width="90"/>
                                <DataGridTemplateColumn Header="Konteineris" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource ContainerCodeConverter}">
                                                        <Binding Path="ContainerId"/>
                                                        <Binding Path="DataContext.Containers" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Kaina" Binding="{Binding UnitPrice, StringFormat=N2}" Width="70"/>
                                <DataGridTextColumn Header="Suma (tikėtasi)" Binding="{Binding ExpectedTotal, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="Sujungta" Binding="{Binding IsMerged}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Konteineriai">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                            <Button Content="Naujas konteineris" Padding="10,4" Margin="0,0,8,0"
                                    Command="{Binding AddContainerCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="Spausdinti valdymo lapą (visi kodai)" Padding="10,4"
                                    Command="{Binding PrintControlSheetCommand}"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding Containers}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Kodas" DisplayMemberBinding="{Binding Code}" Width="120"/>
                                    <GridViewColumn Header="Pavadinimas" DisplayMemberBinding="{Binding DisplayName}" Width="200"/>
                                    <GridViewColumn Header="Sukurta" DisplayMemberBinding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                                    <GridViewColumn Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Spausdinti etiketę" Padding="6,2"
                                                        Command="{Binding DataContext.PrintContainerLabelCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Peržiūrėti turinį" Padding="6,2"
                                                        Command="{Binding DataContext.ShowContainerContentsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="Kodai">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Spausdinti šį lapą (A4)" Padding="10,4"
                                    Command="{Binding PrintControlSheetCommand}"/>
                            <TextBlock Text="Visi veiksmų ir konteinerių kodai vienoje vietoje – galima peržiūrėti ekrane arba išsispausdinti ir nešiotis su savimi."
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="Gray"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Veiksmų kodai" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding CommandBarcodeItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="LightGray" BorderThickness="1" Margin="4" Padding="10" Width="230">
                                                <StackPanel>
                                                    <Image Source="{Binding Code, Converter={StaticResource BarcodeValueConverter}}" Height="60" Stretch="Uniform"/>
                                                    <TextBlock Text="{Binding Caption}" TextAlignment="Center" Margin="0,6,0,0" FontWeight="Bold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Konteinerių kodai" FontSize="16" FontWeight="Bold" Margin="0,20,0,8"/>
                                <ItemsControl ItemsSource="{Binding Containers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="LightGray" BorderThickness="1" Margin="4" Padding="10" Width="230">
                                                <StackPanel>
                                                    <Image Source="{Binding Code, Converter={StaticResource BarcodeValueConverter}}" Height="60" Stretch="Uniform"/>
                                                    <TextBlock Text="{Binding Code}" TextAlignment="Center" FontWeight="Bold" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" FontSize="11" Foreground="Gray"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Ataskaita">
                    <StackPanel Margin="16">
                        <TextBlock Text="Galutinė ataskaita" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Button Content="Eksportuoti į PDF" Padding="10,6" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8"
                                Command="{Binding ExportReportPdfCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Eksportuoti į Excel" Padding="10,6" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8"
                                Command="{Binding ExportReportExcelCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Spausdinti ataskaitą" Padding="10,6" Width="220" HorizontalAlignment="Left"
                                Command="{Binding PrintReportCommand}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
